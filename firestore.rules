rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && myRole() == 'super_admin';
    }

    function isAdminLevel() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'super_admin');
    }

    function isEditor() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'super_admin' || myRole() == 'n1');
    }

    // ---- Profils utilisateurs ----
    // Chacun peut lire son propre profil et ceux des autres (pour afficher
    // les noms dans les listes). Admin/Super Admin peuvent créer/modifier
    // un profil (c'est ainsi que l'on attribue les rôles) — mais un simple
    // Admin ne peut ni créer/promouvoir un compte Admin ou Super Admin, ni
    // modifier un compte qui est déjà Admin ou Super Admin : seul un Super
    // Admin peut toucher à ce niveau (protection contre la rétrogradation
    // accidentelle ou l'auto-promotion).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin()
        || (isAdminLevel()
            && !(resource != null && (resource.data.role == 'admin' || resource.data.role == 'super_admin'))
            && request.resource.data.role != 'admin' && request.resource.data.role != 'super_admin');
    }

    // ---- Configuration (noms N1/N2, paramètres) ----
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    // ---- Absences ----
    match /absences/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    // ---- Interventions ----
    // Tout le monde peut lire. Un éditeur (admin/n1) peut tout écrire.
    // Un technicien peut créer une intervention et supprimer UNIQUEMENT
    // celles qu'il a lui-même créées (createdBy == son propre uid).
    match /interventions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isEditor() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }
    // ---- Heures (agents d'entretien / temps partiel) ----
    // Chacun ne peut créer QUE ses propres heures (uid == son uid).
    // Seul un éditeur (admin/n1) peut valider (update). La direction peut
    // seulement lire. Suppression : éditeur, ou la personne elle-même tant
    // que l'entrée n'est pas encore validée.
    match /heures/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isEditor();
      allow delete: if isEditor() || (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.validated == false);
    }
    // ---- Invitations (accès remplaçant par QR code / lien) ----
    // N'importe qui connecté (y compris en mode invité anonyme) peut LIRE
    // une invitation précise s'il connaît son identifiant (le lien/QR).
    // Seul un éditeur peut lister toutes les invitations ou en créer.
    match /invitations/{token} {
      allow get: if isSignedIn();
      allow list: if isEditor();
      allow write: if isEditor();
    }

    // ---- Fiches de traçabilité ménage ----
    // Chacun peut créer/modifier SES PROPRES fiches (agentUid == son uid).
    // Un éditeur (admin/n1) peut tout modifier. Tout le monde peut lire
    // (onglet Traçabilité). Fonctionne aussi pour les comptes invités
    // anonymes (mode remplaçant via QR code), qui ont un uid Firebase
    // comme n'importe quel autre compte connecté.
    match /fiches/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isEditor() || request.resource.data.agentUid == request.auth.uid);
      allow delete: if isEditor() || (isSignedIn() && resource.data.agentUid == request.auth.uid);
    }
    // ---- Répartition hebdomadaire des heures par tâche ----
    // Même logique que fiches : chacun gère ses propres enregistrements,
    // un éditeur (admin/n1) peut tout gérer (y compris remplir au nom
    // d'un agent).
    match /heures-repartition/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isEditor() || request.resource.data.agentUid == request.auth.uid);
      allow delete: if isEditor() || (isSignedIn() && resource.data.agentUid == request.auth.uid);
    }
    // ---- Confirmations de transfert de ligne téléphonique (N1) ----
    // N'importe quel utilisateur connecté peut lire et confirmer un
    // transfert (un seul document par jour, écrasé si reconfirmé).
    // Annuler une confirmation (delete, pour recommencer en cas d'erreur)
    // est réservé Super Admin.
    match /transferts-ligne/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.confirmedBy == request.auth.uid;
      allow delete: if isSuperAdmin();
    }
    // ---- Relevés d'heures d'interventions validés (archive) ----
    match /releves-interventions/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }
    // ---- Dossiers de site (sécurité, contacts, organes techniques) ----
    // La mise à la corbeille est une mise à jour (isEditor). La purge
    // définitive (delete réel) est réservée Super Admin.
    match /sites-dossiers/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isEditor();
      allow delete: if isSuperAdmin();
    }
    // ---- Stock de maintenance (produits, historique d'inventaire) ----
    // Lecture ouverte à tous les connectés (utile pour l'inventaire par
    // scan, accessible aussi aux techniciens). Écriture réservée aux
    // éditeurs (admin/n1), sauf le comptage d'inventaire (mouvements) que
    // n'importe quel utilisateur connecté peut créer.
    match /stock-produits/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isEditor();
      allow delete: if isSuperAdmin();
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockActuel', 'dateDernierInventaire']);
    }
    match /stock-mouvements/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isEditor();
    }
    match /stock-commandes/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }
  }
}
