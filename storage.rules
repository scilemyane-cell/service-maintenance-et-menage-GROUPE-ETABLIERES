rules_version = '2';

// Utilisé UNIQUEMENT pour dossiers-pdf-public/ (copie publique du PDF
// d'un dossier de site, destinée aux prestataires externes sans compte —
// voir pdf-public-share.js). Contournement ponctuel validé par Valentin
// faute d'alternative SharePoint (partage public par lien désactivé sur
// le tenant Microsoft 365). Tout le reste est fermé par défaut : cette
// appli n'utilise pas Firebase Storage pour autre chose (photos, fichiers
// de dossiers, etc. passent par SharePoint).
service firebase.storage {
  match /b/{bucket}/o {
    match /dossiers-pdf-public/{fileName} {
      // Lecture publique, sans authentification — c'est tout l'intérêt :
      // un prestataire externe sans compte doit pouvoir ouvrir le PDF.
      allow read: if true;
      // Écriture réservée aux utilisateurs connectés (l'appli ne propose
      // le bouton de publication qu'aux éditeurs admin/n1/super_admin,
      // mais la règle ci-dessous ne peut pas vérifier ce rôle sans appel
      // Firestore coûteux à chaque écriture — se contente donc d'exiger
      // une connexion, cohérent avec le niveau de risque : seul un PDF
      // récapitulatif d'un dossier existant peut y être déposé).
      allow write: if request.auth != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 30 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
