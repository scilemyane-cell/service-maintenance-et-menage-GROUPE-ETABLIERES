rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }

    // Photos des dossiers de site : tout utilisateur connecté peut voir,
    // seuls admin/n1 peuvent envoyer/supprimer (contrôle fait aussi côté
    // Firestore, ici en renfort — pas de vérification de rôle possible
    // nativement dans les règles Storage sans lecture Firestore, donc on
    // se limite à exiger d'être connecté pour écrire).
    match /sites-dossiers/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
